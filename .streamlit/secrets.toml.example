# Copie para .streamlit/secrets.toml (local) ou cole em Settings -> Secrets (Streamlit Cloud). NUNCA commitar o secrets.toml real.
SUPABASE_URL = "https://<projeto>.supabase.co"
SUPABASE_ANON_KEY = "<chave anon/public — NUNCA a service_role>"
DATABASE_URL = "postgresql://gdf_app.<projeto>:<senha>@<host-do-pooler>:5432/postgres"   # role gdf_app, nunca postgres
